{
  "name": "awesome-laminar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "bun scripts/generate.ts && bun run fmt && bun run fix",
    "generate:force": "bun scripts/generate.ts --force && bun run fmt && bun run fix",
    "generate:verbose": "bun scripts/generate.ts --verbose",
    "generate:validate": "bun scripts/generate.ts --validate",
    "generate:ir": "bun scripts/gen-ir.ts",
    "generate:types": "bun scripts/extract-shared-types.ts",
    "generate:components": "bun scripts/generate-components.ts",
    "fix": "./mill __.fix",
    "fmt": "./mill mill.scalalib.scalafmt/",
    "dev": "bun --filter docs dev",
    "generate:docs": "bun docs/generate-examples.ts",
    "compile": "bun run generate:docs && ./mill __.fullLinkJS && bun docs/build.ts"
  },
  "workspaces": [
    "docs"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@typescript/typescript6": "6.0.2",
    "code-block-writer": "13.0.3",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0"
  }
}
